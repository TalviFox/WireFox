<Page x:Class="WireFox.Views.TrustedNetworksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WireFox.ViewModels"
      Title="Trusted Networks"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Padding="32,24,32,32">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
            
            <!-- Page Title -->
            <ui:TextBlock Text="Trusted Networks" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBlock Text="WireGuard will automatically disconnect on these networks and local gateways." 
                          FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,22" />

            <!-- Add Wi-Fi / Domain Card -->
            <ui:Card Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Globe24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Add Trusted Wi-Fi / Domain" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Enter a Wi-Fi SSID (e.g. HomeWifi_5G) or connection domain suffix to trust." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" 
                                    Text="{Binding NewNetworkSsid, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="e.g. HomeWifi_5G or corp.local"
                                    MinHeight="36"
                                    HorizontalAlignment="Stretch" />
                        <ui:Button Grid.Column="2"
                                   Appearance="Primary"
                                   Content="Add Network"
                                   Command="{Binding AddNetworkCommand}"
                                   MinHeight="36"
                                   Padding="16,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- Network List Section -->
            <ui:TextBlock Text="Configured SSIDs &amp; Domains" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ItemsControl ItemsSource="{Binding TrustedNetworks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,8" Padding="14">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />
                                    <ui:TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Appearance="Danger"
                                       Content="Remove"
                                       MinHeight="32"
                                       Padding="14,4"
                                       Command="{Binding DataContext.RemoveNetworkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,16,0,16" />

            <!-- Add Trusted Gateway Card -->
            <ui:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Router24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Add Trusted Gateway / Hardware" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Register a local gateway with its hardware MAC address and optional stacked names to auto-bypass VPN." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding NewGatewayName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Profile Name (e.g. Home LAN)" MinHeight="36" />
                        <ui:TextBox Grid.Column="2" Text="{Binding NewGatewayIp, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Gateway IP (e.g. 192.168.1.1)" MinHeight="36" />
                    </Grid>
                    
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding NewGatewayMac, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Gateway MAC (e.g. AA:BB:CC:DD:EE:FF)" MinHeight="36" />
                        <ui:TextBox Grid.Column="2" Text="{Binding NewStackedName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Stacked Name / Domain (Optional)" MinHeight="36" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Secondary"
                                   Content="Fill Detected Info"
                                   Command="{Binding QuickFillDetectedCommand}"
                                   MinHeight="36"
                                   Padding="14,6"
                                   Margin="0,0,10,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Appearance="Primary"
                                   Content="Save Gateway"
                                   Command="{Binding AddGatewayCommand}"
                                   MinHeight="36"
                                   Padding="16,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Configured Gateways Section -->
            <ui:TextBlock Text="Configured Gateways (Wired &amp; Wireless)" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ItemsControl ItemsSource="{Binding TrustedGateways}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Margin="0,0,0,8" Padding="14">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Router24" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                                        <ui:TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ui:TextBlock Text="{Binding IpAddress}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,6,0,0">
                                        <ui:TextBlock Text="MAC: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:TextBlock Text="{Binding MacAddress}" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0" />
                                        
                                        <!-- Stacked Names display -->
                                        <ItemsControl ItemsSource="{Binding StackedNames}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SystemAccentColorTertiaryBrush}" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,6,0">
                                                        <ui:TextBlock Text="{Binding}" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Appearance="Danger"
                                       Content="Remove"
                                       MinHeight="32"
                                       Padding="14,4"
                                       Command="{Binding DataContext.RemoveGatewayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
