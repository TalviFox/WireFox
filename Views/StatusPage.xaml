<Page x:Class="WireFox.Views.StatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WireFox.ViewModels"
      Title="Status"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Page.Resources>

    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Padding="32,24,32,32">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
            
            <!-- Page Title -->
            <ui:TextBlock Text="Status" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- Hero Status Card -->
            <ui:CardControl Padding="20" Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="{Binding StatusSymbol}" FontSize="34" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Text="Tunnel State" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />
                            <ui:TextBlock Text="{Binding ActiveTunnelName, StringFormat='Tunnel: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IsTunnelActive, Mode=OneWay}"
                                 Command="{Binding ToggleTunnelCommand}"
                                 OnContent="Enabled"
                                 OffContent="Disabled"
                                 HorizontalAlignment="Right" />
            </ui:CardControl>

            <!-- MAC Mismatch Warning Card -->
            <ui:CardControl Padding="16" Margin="0,0,0,16" Visibility="{Binding IsMacMismatch, Converter={StaticResource BoolToVisConverter}}">
                <ui:CardControl.Header>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Gateway Hardware Changed" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <ui:TextBlock Text="{Binding MacMismatchMessage}" 
                                      TextWrapping="Wrap"
                                      FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Caution"
                           Content="Update Stored MAC"
                           MinHeight="36"
                           Padding="14,6"
                           Command="{Binding UpdateGatewayMacCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:Button.Icon>
                </ui:Button>
            </ui:CardControl>

            <!-- Vitals Card -->
            <ui:CardControl Padding="18" Margin="0,0,0,16">
                <ui:CardControl.Header>
                    <StackPanel>
                        <!-- Current Network Vital -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                                <ui:TextBlock Text="Current Network" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1" Text="{Binding CurrentNetworkText}" 
                                          FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Gateway / DNS Details -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Router24" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                                <ui:TextBlock Text="Connection Details" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1" Text="{Binding GatewayInfoText}" 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          TextAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="0,4,0,8" />

                        <!-- Last Handshake Vital -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                                <ui:TextBlock Text="Last Handshake" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1" Text="{Binding HandshakeAgeText}" 
                                          FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Data Transferred Vital -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0" />
                                <ui:TextBlock Text="Data Transferred" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1" Text="{Binding TransferStatsText}" 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Session Countdown Vital (if active) -->
                        <Grid Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Timer24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,10,0" />
                                <ui:TextBlock Text="Temporary Session" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1" Text="{Binding SessionCountdownText}" 
                                          Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                          FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Quick Trust Action Card (visible on untrusted network) -->
            <ui:CardControl Padding="16" Margin="0,0,0,16" Visibility="{Binding CanTrustCurrentNetwork, Converter={StaticResource BoolToVisConverter}}">
                <ui:CardControl.Header>
                    <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock Text="Trust this Network / Gateway" FontWeight="SemiBold" FontSize="14" />
                        <ui:TextBlock Text="Add active Wi-Fi, Gateway IP, MAC, and detected domains to trusted list and bypass VPN." 
                                      FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Primary"
                           Content="Trust Network"
                           MinHeight="36"
                           Padding="16,6"
                           Command="{Binding TrustCurrentNetworkCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" />
                    </ui:Button.Icon>
                </ui:Button>
            </ui:CardControl>

            <!-- Quick Untrust Action Card (visible on trusted network) -->
            <ui:CardControl Padding="16" Margin="0,0,0,16" Visibility="{Binding CanUntrustCurrentNetwork, Converter={StaticResource BoolToVisConverter}}">
                <ui:CardControl.Header>
                    <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock Text="Untrust this Network / Gateway" FontWeight="SemiBold" FontSize="14" />
                        <ui:TextBlock Text="Remove active Wi-Fi and Gateway from trusted list and immediately re-engage WireGuard protection." 
                                      FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Danger"
                           Content="Untrust Network"
                           MinHeight="36"
                           Padding="16,6"
                           Command="{Binding UntrustCurrentNetworkCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ShieldDismiss24" />
                    </ui:Button.Icon>
                </ui:Button>
            </ui:CardControl>

            <!-- Quick Actions Group -->
            <ui:TextBlock Text="Quick Actions" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            
            <UniformGrid Columns="3">
                <ui:Button Margin="0,0,6,0" HorizontalAlignment="Stretch"
                           Appearance="Secondary"
                           Content="Pause 15 Mins"
                           MinHeight="42"
                           Padding="8,8"
                           Command="{Binding Pause15Command}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Pause24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button Margin="3,0,3,0" HorizontalAlignment="Stretch"
                           Appearance="Secondary"
                           Content="Split-Tunnel"
                           MinHeight="42"
                           Padding="8,8"
                           Command="{Binding SplitTunnel15Command}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button Margin="6,0,0,0" HorizontalAlignment="Stretch"
                           Appearance="Secondary"
                           Content="Full Tunnel"
                           MinHeight="42"
                           Padding="8,8"
                           Command="{Binding RevertFullCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</Page>
