<Page x:Class="WireFox.Views.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WireFox.ViewModels"
      Title="Diagnostics"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <ui:TextBlock Grid.Row="0" Text="Diagnostics &amp; Logs" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <!-- System Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: WireGuard State -->
            <ui:CardControl Grid.Column="0" Padding="14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="WireGuard Subsystem" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <ui:TextBlock Text="{Binding WireGuardStatus}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Text="{Binding ActiveTunnelStatus, StringFormat='Active: {0}'}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Card 2: Network / Gateway -->
            <ui:CardControl Grid.Column="2" Padding="14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="Network Interface" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <ui:TextBlock Text="{Binding PrimaryNetworkStatus}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:TextBlock Text="{Binding GatewayStatus, StringFormat='Gateway: {0}'}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
        </Grid>

        <!-- Actions Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Appearance="Primary"
                       Content="Run Diagnostic Scan"
                       Command="{Binding RunScanCommand}"
                       Margin="0,0,8,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button Appearance="Secondary"
                       Content="Copy Logs"
                       Command="{Binding CopyLogsCommand}"
                       Margin="0,0,8,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button Appearance="Secondary"
                       Content="Open Log File"
                       Command="{Binding OpenLogFileCommand}"
                       Margin="0,0,8,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="DocumentText24" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button Appearance="Secondary"
                       Content="Clear"
                       Command="{Binding ClearLogsCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>

        <!-- Live Log Console -->
        <Border Grid.Row="3" 
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ListBox x:Name="LogsList"
                     ItemsSource="{Binding Logs}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="8"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                            
                            <Border Grid.Column="1" Margin="0,0,8,0" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Info">
                                                    <Setter Property="Foreground" Value="#3B82F6" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Foreground" Value="#F59E0B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Grid.Column="2" Text="{Binding Category}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" />
                            
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Details}" Visibility="{Binding Details, Converter={x:Null}}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Page>
