<ui:FluentWindow x:Class="WireFox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:WireFox.Views"
        xmlns:vm="clr-namespace:WireFox.ViewModels"
        Title="WireFox - WireGuard Roaming Assistant"
        Height="660" Width="920"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="WireFox" />

        <!-- Navigation View -->
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneOpen="True">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Status" TargetPageType="{x:Type views:StatusPage}"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ShieldCheckmark24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Trusted Networks" TargetPageType="{x:Type views:TrustedNetworksPage}"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="WifiSettings20" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Diagnostics" TargetPageType="{x:Type views:DiagnosticsPage}"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DocumentText24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type views:SettingsPage}"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            
                
            
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>

