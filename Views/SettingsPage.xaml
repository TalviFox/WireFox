<Page x:Class="WireFox.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WireFox.ViewModels"
      Title="Settings"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Page.Resources>

    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Padding="32,24,32,32">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
            
            <!-- Page Title -->
            <ui:TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBlock Text="Configure WireGuard interface, watchdog thresholds, and application preferences." 
                          FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,18" />

            <!-- Initial Deployment / Setup Card (visible if %appdata% was missing or wiped) -->
            <ui:Card Padding="18" Margin="0,0,0,20"
                     Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                     BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                     BorderThickness="1.5"
                     Visibility="{Binding IsInitialSetup, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Shield24" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Welcome! Setup Default WireGuard Tunnel" FontSize="16" FontWeight="SemiBold" />
                            <ui:TextBlock Text="No saved configuration was found in %AppData% (new deployment or wiped profile). Choose or import your default tunnel below, then click Confirm to activate seamless protection." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" 
                                      Text="{Binding InitialSetupPromptText}"
                                      FontSize="12" 
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      TextWrapping="Wrap" />
                        <ui:Button Grid.Column="1"
                                   Appearance="Primary"
                                   Content="Confirm Default Tunnel &amp; Start"
                                   Command="{Binding CompleteInitialSetupCommand}"
                                   MinHeight="36"
                                   Padding="16,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Checkmark24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- Section 1: Tunnel Profile Configuration -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="Tunnel Profile Configuration" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Border Grid.Column="1" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Shield24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" />
                        <ui:TextBlock Text="Profile: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <ui:TextBlock Text="{Binding InterfaceName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Interface Name & Config Card -->
            <ui:Card Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Shield24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="WireGuard Interface / Tunnel" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Select a discovered tunnel, type an interface name (e.g. wg0), or import a .conf profile. Settings below are saved per tunnel." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableTunnels}" 
                                  SelectedItem="{Binding InterfaceName, Mode=TwoWay}" 
                                  Text="{Binding InterfaceName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                  IsEditable="True"
                                  MinHeight="36"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center" />
                        <ui:Button Grid.Column="2"
                                   Content="Browse..."
                                   Command="{Binding BrowseConfigFileCommand}"
                                   MinHeight="36"
                                   Padding="14,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Grid.Column="4"
                                   Content="Refresh"
                                   Command="{Binding RefreshTunnelsCommand}"
                                   MinHeight="36"
                                   Padding="14,6">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- Handshake Timeout -->
            <ui:CardControl Padding="16" Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Timer24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Handshake Timeout (Seconds)" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Maximum allowable age for latest handshake before reconnecting or prompting." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
                <ui:NumberBox Value="{Binding HandshakeTimeoutSeconds, Mode=TwoWay}"
                              SmallChange="10"
                              LargeChange="30"
                              Minimum="30"
                              Maximum="600"
                              MinWidth="140"
                              MinHeight="36"
                              HorizontalAlignment="Right" />
            </ui:CardControl>

            <!-- Full-Tunnel Subnet -->
            <ui:CardControl Padding="16" Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Globe24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Full-Tunnel Allowed IPs" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Subnets routed through VPN during full-tunnel mode (default: 0.0.0.0/0, ::/0 routes all internet traffic)." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:TextBox Text="{Binding FullTunnelAllowedIPs, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="0.0.0.0/0, ::/0"
                                MinWidth="170" MaxWidth="240"
                                MinHeight="36"
                                Margin="0,0,8,0" />
                    <ui:Button ToolTip="Auto-detect from active tunnel or .conf file"
                               Command="{Binding DetectAllowedIpsCommand}"
                               MinHeight="36" Padding="10,6">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button ToolTip="Reset to full internet default (0.0.0.0/0, ::/0)"
                               Command="{Binding ResetFullTunnelIpsCommand}"
                               MinHeight="36" Padding="10,6" Margin="6,0,0,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:CardControl>

            <!-- Split-Tunnel Subnet -->
            <ui:CardControl Padding="16" Margin="0,0,0,18">
                <ui:CardControl.Header>
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Split-Tunnel Allowed IPs" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Specific subnets routed through VPN during temporary split-tunnel mode (e.g. 10.0.0.0/8, 192.168.1.0/24)." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:TextBox Text="{Binding SplitTunnelAllowedIPs, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="e.g. 10.0.0.0/8, 192.168.1.0/24"
                                MinWidth="170" MaxWidth="240"
                                MinHeight="36"
                                Margin="0,0,8,0" />
                    <ui:Button ToolTip="Clear split-tunnel IPs"
                               Command="{Binding ClearSplitTunnelIpsCommand}"
                               MinHeight="36" Padding="10,6">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:CardControl>

            <!-- Section 2: Preferences -->
            <ui:TextBlock Text="Preferences" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Theme Selector -->
            <ui:CardControl Padding="16" Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Color24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Application Theme" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Choose system default, light, or dark mode." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding Themes}" 
                          SelectedItem="{Binding SelectedTheme}" 
                          MinWidth="150"
                          MinHeight="36"
                          HorizontalAlignment="Right" />
            </ui:CardControl>

            <!-- Portable Mode Security Notice & Install Card -->
            <ui:Card Padding="16" Margin="0,0,0,12"
                     Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                     BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                     BorderThickness="1"
                     Visibility="{Binding IsPortableMode, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ui:TextBlock Text="Running in Portable Mode" FontWeight="SemiBold" FontSize="13" />
                        <ui:TextBlock Text="For Windows security, elevated auto-start and in-place updates require installation to Program Files." 
                                      FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="2"
                               Appearance="Primary"
                               Content="Install to Program Files"
                               Command="{Binding InstallToProgramFilesCommand}"
                               VerticalAlignment="Center">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </ui:Card>

            <!-- Start with Windows -->
            <ui:CardControl Padding="16" Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Automatically launch elevated at logon via Windows Scheduled Task (WireFox)." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsEnabled="{Binding CanEnableStartup}" HorizontalAlignment="Right" />
            </ui:CardControl>

            <!-- Start Minimized -->
            <ui:CardControl Padding="16" Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="AppGeneric24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Start Minimized" FontWeight="SemiBold" FontSize="14" />
                            <ui:TextBlock Text="Launch silently to the system tray without opening the main window." 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}" HorizontalAlignment="Right" />
            </ui:CardControl>

            <!-- Section 3: Updates & Binary Integrity -->
            <ui:TextBlock Text="Updates &amp; Binary Integrity" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:Card Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" />
                                <ui:TextBlock Text="Release Version &amp; SHA-256 Checksum" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding CurrentVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                </Border>
                            </WrapPanel>
                            <ui:TextBlock Text="WireFox releases are cryptographically matched to GitHub Releases over TLS. You can audit this executable at any time."
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Content="Check for Updates"
                                       Command="{Binding CheckForUpdatesCommand}"
                                       Margin="0,0,8,4" />
                            <ui:Button Content="External Hash Audit"
                                       Command="{Binding RunAuditCommand}"
                                       ToolTip="Launch independent external PowerShell auditor from GitHub"
                                       Margin="0,0,0,4" />
                        </WrapPanel>
                    </Grid>

                    <!-- Hash display bar -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="Local SHA-256: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <ui:TextBlock Grid.Column="1" Text="{Binding LocalHash}" FontFamily="Consolas, monospace" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0" />
                            <ui:Button Grid.Column="2" Content="Copy Hash" Padding="8,4" FontSize="11" Command="{Binding CopyHashCommand}" />
                        </Grid>
                    </Border>

                    <!-- Update Status bar -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ui:TextBlock Text="{Binding UpdateStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <ui:TextBlock Text="{Binding UpdateProgressText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisConverter}}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Appearance="Primary"
                                   Content="Update Now"
                                   Command="{Binding ApplyUpdateCommand}"
                                   Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}" />
                    </Grid>

                    <Separator Margin="0,4,0,10" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <!-- Automatic update check toggle -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ui:TextBlock Text="Automatic Update Checks" FontSize="13" FontWeight="SemiBold" />
                            <ui:TextBlock Text="Silently check GitHub Releases once daily and notify when an official update is available." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Section 4: About WireFox -->
            <ui:TextBlock Text="About • FoxDen Software" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:Card Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48" CornerRadius="8" Margin="0,0,16,0" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Image Source="/wirefox_icon.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <WrapPanel Orientation="Horizontal">
                                <ui:TextBlock Text="WireFox" FontSize="18" FontWeight="Bold" Margin="0,0,8,4" VerticalAlignment="Center" />
                                <ui:TextBlock Text="by FoxDen Software" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,10,4" />
                                <Border Margin="0,0,8,4" Padding="8,2" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding CurrentVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Border Margin="0,0,0,4" Padding="8,2" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <ui:TextBlock Text="License: PolyForm Perimeter" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </WrapPanel>
                            <ui:TextBlock Text="Copyright © 2026 FoxDen Software • Automated WireGuard Roaming Assistant" 
                                          FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,14,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <StackPanel>
                            <ui:TextBlock Text="Developed and maintained by FoxDen Software. Source-available under PolyForm Perimeter License 1.0.0 — free to inspect, fork, and use; commercial competition/repackaging prohibited." 
                                          FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                            <ui:TextBlock Text="WireGuard® is a registered trademark of Jason A. Donenfeld. WireFox is an independent companion tool and is not affiliated with, endorsed by, or sponsored by Jason A. Donenfeld or the WireGuard development team." 
                                          FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Uninstaller Action -->
                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="Clean System Removal" FontSize="12" FontWeight="SemiBold" />
                                <ui:TextBlock Text="Cleanly deletes scheduled boot tasks, Start Menu shortcuts, and Program Files directory." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Appearance="Danger"
                                       Content="Uninstall WireFox"
                                       Command="{Binding UninstallCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>

